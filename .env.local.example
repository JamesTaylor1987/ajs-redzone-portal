# Copy this file to .env.local and fill in real values.
# DO NOT commit .env.local to git.

# === Supabase ===
# From Supabase project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# === App config ===
# Used for absolute links in emails, magic links, etc.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AJS contact details shown to customers
NEXT_PUBLIC_AJS_EMAIL=rz@ajsspalding.co.uk
NEXT_PUBLIC_AJS_PHONE=01406 424954

# FX rate placeholder (live FX integration comes later)
# GBP -> EUR base rate; portal applies +1.5% margin per URS FR-04
NEXT_PUBLIC_FX_GBP_TO_EUR=1.17

# === Resend (email) ===
# Get key from resend.com → API Keys.
# Domain ajsspalding.co.uk must be verified in Resend before emails send from rz@ajsspalding.co.uk.
# Leave blank in dev to skip email sending (quote submission still works).
RESEND_API_KEY=
# Temp sending domain — use Resend's shared domain until ajsspalding.co.uk is verified.
# With the shared domain, ALL emails are redirected to RESEND_TEST_TO (Resend restriction).
# Once ajsspalding.co.uk is verified in Resend: delete both lines below and emails route normally.
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TEST_TO=james@ajsspalding.co.uk
