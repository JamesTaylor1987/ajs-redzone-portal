# Copy this file to .env.local and fill in real values.
# DO NOT commit .env.local to git.

# === Supabase ===
# From Supabase project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# === App config ===
# Used for absolute links in emails, magic links, etc.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AJS contact details shown to customers
NEXT_PUBLIC_AJS_EMAIL=rz@ajsspalding.co.uk
NEXT_PUBLIC_AJS_PHONE=01406 424954

# FX rate placeholder (live FX integration comes later)
# GBP -> EUR base rate; portal applies +1.5% margin per URS FR-04
NEXT_PUBLIC_FX_GBP_TO_EUR=1.17
